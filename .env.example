# RegionCUA 环境变量配置
# 复制为 .env 后按需修改。所有字段均有默认值，无 .env 也可运行。

# 后端提供者：ollama（默认）或 vllm
# Ollama 使用 /api/chat 端点，vLLM 使用 OpenAI 兼容的 /v1/chat/completions 端点
PROVIDER=ollama

# ============================= Ollama =============================
# Ollama 服务地址
OLLAMA_HOST=http://localhost:11434

# 规划模型与视觉模型默认使用同一个模型 qwen3.6:latest，
# 避免 Ollama 在两个模型间切换时反复加载/卸载（每次切换 30+ 秒）。
# qwen3.6:latest 是 35B MoE，原生支持 vision + tools + thinking。
OLLAMA_PLANNER_MODEL=qwen3.6:latest

# 视觉模型（保持与规划模型一致，避免模型切换开销）
OLLAMA_VISION_MODEL=qwen3.6:latest

# Ollama 单次请求超时（秒）。模型未驻留 VRAM 时加载较慢，需设大
OLLAMA_TIMEOUT=600

# ============================= vLLM =============================
# vLLM 服务地址（OpenAI 兼容 API）
VLLM_HOST=http://localhost:8000

# vLLM 模型名（需与 vLLM 启动时 --model 参数一致）
VLLM_MODEL=qwen3.6:latest

# ============================= 通用 =============================
# 输出根目录
OUTPUT_DIR=outputs

# 连续失败多少次后暂停并询问用户
MAX_CONSECUTIVE_FAILURES=3

# 录屏帧率（默认 5fps，回看流畅度与文件大小的平衡点）
VIDEO_FPS=5
